# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real API keys.

# Required: get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Verify current model slugs at https://openrouter.ai/models — must
# support tool calling.
CHAT_MODEL=anthropic/claude-sonnet-4.5

# URL of the Audited Tool Bridge's MCP server (mcp_server/server.py),
# running over Streamable HTTP. Start the server BEFORE the agent
# service — see README.md.
MCP_SERVER_URL=http://localhost:8765/mcp

MAX_ITERATIONS=8
RECURSION_LIMIT=50
REQUEST_TIMEOUT_SECONDS=60
