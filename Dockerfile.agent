# The Audited Tool Bridge - Agent service image (Week 6 project)
#
# Runs the FastAPI agent (agent/main.py). Must be able to reach the
# MCP server at MCP_SERVER_URL (see docker-compose.yml for the
# service-to-service DNS name to use).

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent/ ./agent/

EXPOSE 8000

CMD ["uvicorn", "agent.main:app", "--host", "0.0.0.0", "--port", "8000"]
